generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── ENUMS ───────────────────────────────────────────────────

enum AccountMode {
  SIMULATED
  LIVE_SCHWAB
}

enum BrokerProvider {
  SCHWAB
}

enum ConnectionStatus {
  ACTIVE
  EXPIRING
  EXPIRED
  ERROR
}

enum PremiumPolicy {
  CASHFLOW
  BASIS_REDUCTION
  REINVEST_ON_CLOSE
}

enum InstrumentType {
  STOCK
  OPTION
}

enum OptionAction {
  STO
  BTC
  BTO
  STC
  EXPIRE
  ASSIGN
  EXERCISE
}

enum StockAction {
  BUY
  SELL
}

enum InstanceStatus {
  OPEN
  FINALIZED
}

enum FinalizationReason {
  CLOSED
  EXPIRED
  ASSIGNED
  EXERCISED
}

enum LedgerType {
  PREMIUM_CREDIT
  PREMIUM_DEBIT
  STOCK_BUY
  STOCK_SELL
  FEE
  ADJUSTMENT
  CASH_DEPOSIT
}

enum CallPut {
  CALL
  PUT
}

enum LongShort {
  LONG
  SHORT
}

enum WheelCategory {
  CORE
  SPECULATION
  RISK_FREE_MONEY
}

enum CorePlanMode {
  ACCUMULATE
  REDUCE_BASIS
  INCOME
}

enum BucketEntryKind {
  PREMIUM_IN
  REINVEST_OUT
  BASIS_APPLIED
  CASH_OUT
  ADJUST
}

enum LotFunding {
  CASH
  PREMIUM
  MIXED
}

enum ReinvestStatus {
  CREATED
  NOTIFIED
  ACKNOWLEDGED
  SNOOZED
  COMPLETED
  PARTIAL_COMPLETED
  SKIPPED
}

enum ReinvestAction {
  CONFIRM_FULL
  CONFIRM_PARTIAL
  SNOOZE
  SKIP
}

enum ImportRowStatus {
  NEW
  DUPLICATE_FILE
  DUPLICATE_EXTERNAL_REF
  DUPLICATE_FINGERPRINT
}

enum StrategyType {
  COVERED_CALL
  SHORT_PUT
  BULL_PUT_SPREAD
  BEAR_CALL_SPREAD
  BULL_CALL_SPREAD
  BEAR_PUT_SPREAD
  IRON_CONDOR
  IRON_BUTTERFLY
  SHORT_STRANGLE
  TIME_SPREAD
  LEAP_CALL
  LEAP_PUT
}

enum OutcomeRating {
  EXCELLENT
  GOOD
  NEUTRAL
  POOR
  TERRIBLE
}

enum NotificationChannel {
  EMAIL
  IN_APP
}

enum NotificationFrequency {
  INSTANT
  DAILY_DIGEST
}

// ─── Market Command Center enums ─────────────────────────────
enum MarketBias {
  BULLISH
  BEARISH
  NEUTRAL
}

enum VolatilityCondition {
  EXPANDING
  CONTRACTING
  ELEVATED
  COMPRESSED
}

enum BreadthCondition {
  BROAD
  NARROW
  MIXED
}

enum AIMaStatus {
  ABOVE_200
  BELOW_200
  MIXED
}

enum AIVolumeCondition {
  ACCUMULATION
  DISTRIBUTION
  NEUTRAL
}

enum ChartSourceType {
  CHART_UPLOAD
  DATA_FEED
}

// ─── Fundamental Research enums ───────────────────────────────
enum FundamentalWatchlistStatus {
  QUEUED
  IN_PROGRESS
  PASSED
  WATCH
  REJECTED
}

enum FundamentalWatchlistSource {
  FINVIZ_CSV
  MANUAL
}

enum YahooFetchStatus {
  PENDING
  FETCHING
  READY
  ERROR
}

enum FundamentalSituationType {
  STANDARD
  MERGER_ARB
  SPIN_OFF
  IPO_SECONDARY
  INSIDER_BUYING
  BUYBACK
  DIVIDEND
}

enum FundamentalVerdict {
  PASS
  WATCH
  REJECT
}

// ─── MODELS ──────────────────────────────────────────────────

model User {
  id             String    @id @default(cuid())
  name           String?
  email          String    @unique
  hashedPassword String
  timezone       String    @default("America/New_York")
  digestHour     Int       @default(16)
  digestMinute   Int       @default(30)
  notifyChannel  NotificationChannel   @default(IN_APP)
  notifyFreq     NotificationFrequency @default(DAILY_DIGEST)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  accounts            Account[]
  notifications       Notification[]
  marketRoutineEntries MarketRoutineEntry[]
  aiChartInsights     AIChartInsight[]
  marketEnvironments  MarketEnvironment[]
  brokerConnections   BrokerConnection[]
  apiCredentials      ApiCredential[]
  researchCriteria    ResearchCriteriaProfile?
  researchStrategies  ResearchStrategy[]
}

// OAuth link to a brokerage login. Tokens are AES-256-GCM encrypted (src/lib/crypto.ts).
model BrokerConnection {
  id               String           @id @default(cuid())
  userId           String
  provider         BrokerProvider
  accessTokenEnc   String
  refreshTokenEnc  String
  accessExpiresAt  DateTime
  refreshExpiresAt DateTime
  status           ConnectionStatus @default(ACTIVE)
  lastSyncAt       DateTime?
  lastError        String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  accounts         Account[]

  @@unique([userId, provider])
}

model Account {
  id                 String        @id @default(cuid())
  userId             String
  name               String
  mode               AccountMode   @default(SIMULATED)
  defaultPolicy      PremiumPolicy?
  cashBalance        Decimal       @default(0) @db.Decimal(14, 4)
  cashflowReserve    Decimal       @default(0) @db.Decimal(14, 4)
  onboardingCompletedAt DateTime?
  notes              String?
  archivedAt         DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  // Broker link (LIVE_SCHWAB). Schwab identifies accounts by an opaque hash.
  brokerConnectionId String?
  brokerAccountHash  String?       @unique
  brokerAccountMask  String?
  brokerAccountType  String?
  lastSyncedAt       DateTime?
  lastSyncError      String?
  syncedNetLiq       Decimal?      @db.Decimal(14, 4)
  syncedBuyingPower  Decimal?      @db.Decimal(14, 4)
  syncedDayPnl       Decimal?      @db.Decimal(14, 4)
  syncedOptionValue  Decimal?      @db.Decimal(14, 4) // Net option market value at last sync (included in net liq)

  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  brokerConnection   BrokerConnection? @relation(fields: [brokerConnectionId], references: [id], onDelete: SetNull)

  underlyings            Underlying[]
  strategyInstances      StrategyInstance[]
  ledgerEntries          LedgerEntry[]
  stockLots              StockLot[]
  reinvestSignals        ReinvestSignal[]
  wheelTargets           WealthWheelTarget[]
  wheelClassifications   WealthWheelClassification[]
  csvImports             CsvImport[]
  journalTrades          JournalTrade[]
  researchIdeas          ResearchIdea[]
  notifications          Notification[]
  fundamentalWatchlistItems FundamentalWatchlistItem[]
  fundamentalResearch    FundamentalResearch[]
  fundamentalSnapshots     FundamentalSnapshot[]
  fundamentalChatThreads   FundamentalChatThread[]
  finvizCsvImports         FinvizCsvImport[]
  premiumBucketEntries     PremiumBucketEntry[]
  dcfModels                DcfModel[]
  companyReports           CompanyReport[]
  companyReportJobs        CompanyReportJob[]
  companyScores            CompanyScore[]

  @@unique([userId, name])
}

model Underlying {
  id            String        @id @default(cuid())
  accountId     String
  symbol        String
  currentPrice  Decimal?      @db.Decimal(12, 4)
  premiumPolicy PremiumPolicy?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  account       Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)

  strategyInstances      StrategyInstance[]
  stockLots              StockLot[]
  reinvestSignals        ReinvestSignal[]
  wheelClassification    WealthWheelClassification?
  journalTrades          JournalTrade[]
  researchIdeas          ResearchIdea[]
  fundamentalResearch    FundamentalResearch[]
  corePlan               CorePlan?
  premiumBucketEntries   PremiumBucketEntry[]

  @@unique([accountId, symbol])
}

model StrategyInstance {
  id                     String              @id @default(cuid())
  accountId              String
  underlyingId           String
  instrumentType         InstrumentType
  strategyType           StrategyType?
  strategyGroupId        String?
  optionAction           OptionAction?
  callPut                CallPut?
  longShort              LongShort?
  strike                 Decimal?            @db.Decimal(12, 2)
  expiration             DateTime?
  quantity               Decimal             @db.Decimal(12, 4)
  status                 InstanceStatus      @default(OPEN)
  finalizationReason     FinalizationReason?
  finalizedAt            DateTime?
  realizedOptionProfit   Decimal?            @db.Decimal(14, 4)
  premiumPolicyOverride  PremiumPolicy?
  wheelCategoryOverride  WheelCategory?
  notes                  String?
  brokerSymbol           String?             // OCC option symbol from the broker, used to match closes
  closedQuantity         Decimal             @default(0) @db.Decimal(12, 4)
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  account                Account             @relation(fields: [accountId], references: [id], onDelete: Cascade)
  underlying             Underlying          @relation(fields: [underlyingId], references: [id], onDelete: Cascade)

  ledgerEntries          LedgerEntry[]
  reinvestSignal         ReinvestSignal?
  journalTrade           JournalTrade?
  premiumBucketEntries   PremiumBucketEntry[]

  @@index([accountId, status])
  @@index([underlyingId])
  @@index([accountId, brokerSymbol])
}

model LedgerEntry {
  id                String         @id @default(cuid())
  accountId         String
  strategyInstanceId String?
  type              LedgerType
  amount            Decimal        @db.Decimal(14, 4)
  description       String?
  occurredAt        DateTime
  externalRef       String?
  fingerprint       String?
  csvImportId       String?
  createdAt         DateTime       @default(now())

  account           Account        @relation(fields: [accountId], references: [id], onDelete: Cascade)
  strategyInstance  StrategyInstance? @relation(fields: [strategyInstanceId], references: [id], onDelete: SetNull)
  csvImport         CsvImport?     @relation(fields: [csvImportId], references: [id], onDelete: SetNull)

  @@unique([accountId, externalRef])
  @@unique([accountId, fingerprint])
  @@index([accountId, occurredAt])
}

model StockLot {
  id               String     @id @default(cuid())
  accountId        String
  underlyingId     String
  acquiredAt       DateTime
  quantity         Decimal    @db.Decimal(12, 4)
  remaining        Decimal    @db.Decimal(12, 4)
  costBasis        Decimal    @db.Decimal(14, 4)  // Original total cost (purchase price × qty + fees)
  premiumReduction Decimal    @default(0) @db.Decimal(14, 4)  // Total premium applied to reduce cost basis
  fundedBy         LotFunding @default(CASH)
  premiumFundedQty Decimal    @default(0) @db.Decimal(12, 4)  // Shares in this lot paid for with core premium
  createdAt        DateTime   @default(now())

  account       Account    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  underlying    Underlying @relation(fields: [underlyingId], references: [id], onDelete: Cascade)

  @@index([accountId, underlyingId, acquiredAt])
}

model ReinvestSignal {
  id              String          @id @default(cuid())
  accountId       String
  underlyingId    String
  instanceId      String          @unique
  amount          Decimal         @db.Decimal(14, 4)
  status          ReinvestStatus  @default(CREATED)
  dueAt           DateTime
  acknowledgedAt  DateTime?
  completedAt     DateTime?
  completedAmount Decimal?        @db.Decimal(14, 4)
  notes           String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  account         Account         @relation(fields: [accountId], references: [id], onDelete: Cascade)
  underlying      Underlying      @relation(fields: [underlyingId], references: [id], onDelete: Cascade)
  instance        StrategyInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  @@index([accountId, status])
}

// Per-holding plan for what happens to premium earned on a CORE stock.
model CorePlan {
  id                      String       @id @default(cuid())
  underlyingId            String       @unique
  mode                    CorePlanMode @default(ACCUMULATE)
  shareGoal               Int?
  modeAfterGoal           CorePlanMode @default(INCOME)
  reinvestThresholdShares Int          @default(1)
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt

  underlying              Underlying   @relation(fields: [underlyingId], references: [id], onDelete: Cascade)
}

// Signed ledger for a CORE stock's premium bucket. Balance = sum(amount).
// PREMIUM_IN is positive; REINVEST_OUT / BASIS_APPLIED / CASH_OUT are negative.
model PremiumBucketEntry {
  id                 String          @id @default(cuid())
  accountId          String
  underlyingId       String
  strategyInstanceId String?
  stockLotId         String?
  kind               BucketEntryKind
  amount             Decimal         @db.Decimal(14, 4)
  shares             Decimal?        @db.Decimal(12, 4)
  price              Decimal?        @db.Decimal(12, 4)
  note               String?
  occurredAt         DateTime
  createdAt          DateTime        @default(now())

  account            Account           @relation(fields: [accountId], references: [id], onDelete: Cascade)
  underlying         Underlying        @relation(fields: [underlyingId], references: [id], onDelete: Cascade)
  strategyInstance   StrategyInstance? @relation(fields: [strategyInstanceId], references: [id], onDelete: SetNull)

  @@index([accountId, underlyingId, occurredAt])
  @@index([strategyInstanceId])
}

model WealthWheelTarget {
  id           String        @id @default(cuid())
  accountId    String
  category     WheelCategory
  targetPct    Decimal       @db.Decimal(5, 2)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  account      Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, category])
}

model WealthWheelClassification {
  id           String        @id @default(cuid())
  accountId    String
  underlyingId String        @unique
  category     WheelCategory
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  account      Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  underlying   Underlying    @relation(fields: [underlyingId], references: [id], onDelete: Cascade)

  @@unique([accountId, underlyingId])
}

model CsvImport {
  id            String    @id @default(cuid())
  accountId     String
  fileName      String
  fileSha256    String
  rowCount      Int
  newCount      Int
  dupCount      Int
  committedAt   DateTime?
  createdAt     DateTime  @default(now())

  account       Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  ledgerEntries LedgerEntry[]

  @@unique([accountId, fileSha256])
}

model JournalTrade {
  id                  String         @id @default(cuid())
  accountId           String
  strategyInstanceId  String?        @unique
  underlyingId        String
  strike              Decimal?       @db.Decimal(12, 2)
  callPut             CallPut?
  longShort           LongShort?
  quantity            Decimal?       @db.Decimal(12, 4)
  entryDelta          Decimal?       @db.Decimal(6, 4)
  entryPrice          Decimal?       @db.Decimal(12, 4)
  entryDateTime       DateTime?
  targetPrice         Decimal?       @db.Decimal(12, 4)
  stopPrice           Decimal?       @db.Decimal(12, 4)
  exitPrice           Decimal?       @db.Decimal(12, 4)
  exitDateTime        DateTime?
  rewardRatio         Decimal?       @db.Decimal(8, 4)
  riskPct             Decimal?       @db.Decimal(8, 4)
  thesisNotes         String?
  outcomeRating       OutcomeRating?
  wheelCategoryOverride WheelCategory?
  marketEnvironmentAtEntry   String?
  environmentScoreAtEntry    Int?
  humanAIAlignmentAtEntry   Decimal?   @db.Decimal(5, 2)
  routineCompletedAtEntry   Boolean    @default(false)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  account             Account          @relation(fields: [accountId], references: [id], onDelete: Cascade)
  underlying          Underlying       @relation(fields: [underlyingId], references: [id], onDelete: Cascade)
  strategyInstance    StrategyInstance? @relation(fields: [strategyInstanceId], references: [id], onDelete: SetNull)

  @@index([accountId])
}

model ResearchIdea {
  id                    String        @id @default(cuid())
  accountId             String
  underlyingId          String
  strategyType          StrategyType
  dte                   Int?
  atr                   Decimal?      @db.Decimal(10, 4)
  strikes               String?          // legacy – kept for backward compat
  deltas                String?          // legacy – kept for backward compat
  netCredit             Decimal?      @db.Decimal(12, 4)
  bpe                   Decimal?      @db.Decimal(14, 4)
  netDelta              Decimal?      @db.Decimal(10, 4)
  roi                   Decimal?      @db.Decimal(8, 4)
  roid                  Decimal?      @db.Decimal(8, 4)
  notes                 String?
  wheelCategoryOverride WheelCategory?
  convertedToJournalId  String?

  // ── Strategy-specific typed fields ───────────────────────
  price                 Decimal?      @db.Decimal(12, 4)  // Current stock price
  month                 String?                            // Expiration month label

  // Single-leg / primary short leg (CC, SP, BPS, BCS, TS)
  shortStrike           Decimal?      @db.Decimal(12, 4)
  shortDelta            Decimal?      @db.Decimal(6, 4)
  longStrike            Decimal?      @db.Decimal(12, 4)  // Protective long leg (BPS, BCS)

  // Multi-leg: call side (IC, SS)
  shortCallStrike       Decimal?      @db.Decimal(12, 4)
  shortCallDelta        Decimal?      @db.Decimal(6, 4)
  longCallStrike        Decimal?      @db.Decimal(12, 4)

  // Multi-leg: put side (IC, SS)
  shortPutStrike        Decimal?      @db.Decimal(12, 4)
  shortPutDelta         Decimal?      @db.Decimal(6, 4)
  longPutStrike         Decimal?      @db.Decimal(12, 4)

  // Short Strangle extras
  earningsDate          String?
  expectedGap           Decimal?      @db.Decimal(10, 4)
  expiration            String?

  // Time Spread extras
  spreadSubType         String?                            // Diag Call, Diag Put, Horiz Call, Horiz Put
  longStrikeExp         String?
  longStrikeDebit       Decimal?      @db.Decimal(12, 4)
  shortStrikeExp        String?
  shortStrikeCredit     Decimal?      @db.Decimal(12, 4)

  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  account               Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  underlying            Underlying    @relation(fields: [underlyingId], references: [id], onDelete: Cascade)

  @@index([accountId, strategyType])
}

model Notification {
  id         String    @id @default(cuid())
  userId     String
  accountId  String?
  title      String
  body       String
  read       Boolean   @default(false)
  sentAt     DateTime?
  createdAt  DateTime  @default(now())

  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  account    Account?  @relation(fields: [accountId], references: [id], onDelete: SetNull)

  @@index([userId, read])
}

model MarketRoutineEntry {
  id                   String              @id @default(cuid())
  userId               String
  date                 DateTime            @db.Date
  humanMarketBias      MarketBias?
  shortTermTrend       MarketBias?
  intermediateTrend    MarketBias?
  longTermTrend        MarketBias?
  volatilityCondition  VolatilityCondition?
  breadthCondition     BreadthCondition?
  narrativeTags        String[]
  notes                String?
  routineCompleted     Boolean             @default(false)
  stepsCompleted       String[]            @default([]) // Trader's Corner routine step keys done today
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  user                 User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  symbolBiases         MarketRoutineSymbolBias[]

  @@unique([userId, date])
  @@index([userId])
}

model MarketRoutineSymbolBias {
  id                   String              @id @default(cuid())
  marketRoutineEntryId String
  symbol               String
  category             String              // INDICES | SECTORS
  bias                 MarketBias?
  dailyVolume          Decimal?            @db.Decimal(18, 0)  // numeric volume for sector rotation insights
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  marketRoutineEntry   MarketRoutineEntry  @relation(fields: [marketRoutineEntryId], references: [id], onDelete: Cascade)

  @@unique([marketRoutineEntryId, symbol])
  @@index([marketRoutineEntryId])
}

model AIChartInsight {
  id                    String            @id @default(cuid())
  userId                String
  date                  DateTime          @db.Date
  symbol                String
  timeframe             String?
  aiTrendAssessment     MarketBias?
  aiMomentumAssessment  String?
  aiMAStatus           AIMaStatus?
  aiVolumeCondition    AIVolumeCondition?
  aiStructureNotes      String?
  aiConfidenceScore     Int?
  sourceType           ChartSourceType    @default(CHART_UPLOAD)
  rawAIResponse        Json?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  user                  User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
}

model MarketEnvironment {
  id                    String    @id @default(cuid())
  userId                String
  date                  DateTime  @db.Date
  environmentScore      Int
  environmentLabel      String
  environmentConfidence Int
  alignmentScore        Decimal?  @db.Decimal(5, 2)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId])
}

// ─── Fundamental Research ─────────────────────────────────────

model FinvizCsvImport {
  id        String   @id @default(cuid())
  accountId String
  filename  String?
  rowCount  Int      @default(0)
  createdAt DateTime @default(now())

  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  items     FundamentalWatchlistItem[]

  @@index([accountId])
}

model FundamentalWatchlistItem {
  id               String                     @id @default(cuid())
  accountId        String
  symbol           String
  status           FundamentalWatchlistStatus @default(QUEUED)
  source           FundamentalWatchlistSource @default(MANUAL)
  finvizImportId   String?
  screenerNotes    String?
  importMetadata   Json?
  yahooFetchStatus YahooFetchStatus           @default(PENDING)
  yahooFetchError  String?
  yahooFetchedAt   DateTime?
  importedAt       DateTime                   @default(now())
  analyzedAt       DateTime?
  updatedAt        DateTime                   @updatedAt

  account          Account                    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  finvizImport     FinvizCsvImport?           @relation(fields: [finvizImportId], references: [id], onDelete: SetNull)

  @@unique([accountId, symbol])
  @@index([accountId])
  @@index([accountId, yahooFetchStatus])
}

model FundamentalSnapshot {
  id                 String   @id @default(cuid())
  accountId          String
  symbol             String
  fetchedAt          DateTime @default(now())
  price              Decimal? @db.Decimal(14, 4)
  trailingPe         Decimal? @db.Decimal(12, 4)
  forwardPe          Decimal? @db.Decimal(12, 4)
  pegRatio           Decimal? @db.Decimal(12, 4)
  enterpriseToEbitda Decimal? @db.Decimal(12, 4)
  priceToBook        Decimal? @db.Decimal(12, 4)
  priceToSales       Decimal? @db.Decimal(12, 4)
  debtToEquity       Decimal? @db.Decimal(12, 4)
  returnOnEquity     Decimal? @db.Decimal(12, 4)
  profitMargins      Decimal? @db.Decimal(12, 4)
  nextEarningsDate   DateTime? @db.Date
  raw                Json?
  financialHistory Json?    // Annual statements from Yahoo fundamentalsTimeSeries (for DCF)
  historyFetchedAt DateTime?

  account            Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, symbol])
  @@index([accountId])
}

model FundamentalResearch {
  id                    String                    @id @default(cuid())
  accountId             String
  symbol                String
  underlyingId          String?
  mgmtCapitalAllocation Int?
  mgmtIncentives        Int?
  mgmtExecution         Int?
  brandPricingPower     Int?
  brandLoyalty          Int?
  brandTrust            Int?
  situationType         FundamentalSituationType  @default(STANDARD)
  situationChecklist    Json?
  earningsReviewedAt    DateTime?
  earningsNotes         String?
  annualEpsGrowth       Decimal?                  @db.Decimal(10, 4)
  revenueGrowth         Decimal?                  @db.Decimal(10, 4)
  verdict               FundamentalVerdict?
  notes                 String?
  bollingerChecklist    Json?
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt

  account               Account                   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  underlying            Underlying?               @relation(fields: [underlyingId], references: [id], onDelete: SetNull)

  @@unique([accountId, symbol])
  @@index([accountId])
}

model FundamentalChatThread {
  id        String   @id @default(cuid())
  accountId String
  symbol    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  messages  FundamentalChatMessage[]

  @@unique([accountId, symbol])
  @@index([accountId])
}

model FundamentalChatMessage {
  id              String   @id @default(cuid())
  threadId        String
  role            String
  content         String
  contextSnapshot Json?
  toolEvents      Json?    // Claude tool calls made while answering (name, input, summary)
  createdAt       DateTime @default(now())

  thread          FundamentalChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId])
}

// Per-user research thresholds (see src/lib/fundamentals/criteria.ts for the shape).
model ResearchCriteriaProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  profile   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Saved DCF runs per symbol (assumptions + computed outputs).
model DcfModel {
  id          String   @id @default(cuid())
  accountId   String
  symbol      String
  name        String?
  assumptions Json
  outputs     Json
  createdBy   String   @default("user") // "user" | "claude"
  createdAt   DateTime @default(now())

  account     Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, symbol, createdAt])
}

// Annual reports (10-K / 20-F) from SEC EDGAR. Public and immutable, so shared across accounts.
model SecFiling {
  id           String    @id @default(cuid())
  cik          String
  symbol       String
  accession    String    @unique
  form         String    // 10-K | 20-F (amendments only when no original exists)
  fiscalYear   Int
  periodEnd    DateTime
  filedAt      DateTime
  url          String
  sections     Json      // { business, riskFactors, mdna, marketRisk } plain text
  riskHeadings Json      // [{ category, title }]
  digest       Json?     // AI summary of the filing (see src/lib/sec/digest.ts)
  digestModel  String?
  digestedAt   DateTime?
  fetchedAt    DateTime  @default(now())

  @@index([symbol])
  @@index([cik])
}

// AI company reports, one per symbol and lens; history is kept.
model CompanyReport {
  id        String   @id @default(cuid())
  accountId String
  symbol    String
  lensKey   String   // buffett | lynch | druckenmiller | strategy:<id> | none
  report    Json
  sources   Json?
  model     String
  createdAt DateTime @default(now())

  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, symbol, lensKey, createdAt])
}

// User-defined research strategies: Finviz screen + scoring criteria + research questions.
model ResearchStrategy {
  id            String   @id @default(cuid())
  userId        String
  name          String
  baseLens      String?
  finvizFilters Json     // string[] of Finviz filter codes
  criteria      Json     // CriteriaProfile (src/lib/fundamentals/criteria.ts)
  questions     Json     // string[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Per-user API keys for third-party data services (e.g. Finviz Elite), encrypted with TOKEN_ENCRYPTION_KEY.
model ApiCredential {
  id         String    @id @default(cuid())
  userId     String
  provider   String    // finviz
  secret     String    // encryptSecret() payload, never returned to the browser
  hint       String    // last 4 characters, for display
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
}

// Background Company Report generation, so progress survives tab switches and page changes.
model CompanyReportJob {
  id         String    @id @default(cuid())
  accountId  String
  symbol     String
  lensKey    String
  status     String    // RUNNING | DONE | ERROR
  stages     Json      @default("[]")
  error      String?
  reportId   String?
  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  account    Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, symbol, lensKey, startedAt])
}

// Saved WealthOS Scores per stock and lens (see src/lib/research/score.ts).
model CompanyScore {
  id         String   @id @default(cuid())
  accountId  String
  symbol     String
  lensKey    String
  score      Int?
  confidence String   // HIGH | MEDIUM | LOW
  result     Json     // ScoreResult: pillars, caps, strengths, weaknesses
  computedAt DateTime @default(now())

  account    Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, symbol, lensKey])
  @@index([accountId, lensKey])
}
