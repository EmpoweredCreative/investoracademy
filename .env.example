# Database (e.g. Vercel Postgres POSTGRES_URL or direct Postgres URL)
DATABASE_URL="postgresql://user:password@host:5432/database?sslmode=require"
POSTGRES_URL="postgresql://user:password@host:5432/database?sslmode=require"

# Prisma Accelerate (optional; only if using accelerateUrl instead of adapter)
# PRISMA_DATABASE_URL="prisma+postgres://accelerate.prisma-data.net/?api_key=your-api-key"

# NextAuth
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# SendGrid (optional for MVP)
SENDGRID_API_KEY="SG.xxxxxxxxxxxx"
SENDGRID_FROM_EMAIL="noreply@yourdomain.com"

# Vercel Cron Secret (optional)
CRON_SECRET="your-cron-secret"

# Anthropic / Claude (Fundamental Research agent, DCF coaching, AI Chart Assist)
ANTHROPIC_API_KEY="sk-ant-..."

# Charles Schwab Trader API (developer.schwab.com → Apps). Callback must match exactly.
# Local: run `npm run dev:https` and open https://127.0.0.1:3000
SCHWAB_CLIENT_ID=""
SCHWAB_CLIENT_SECRET=""
SCHWAB_REDIRECT_URI="https://127.0.0.1:3000/api/brokers/schwab/callback"

# 32 random bytes, base64 — encrypts broker tokens at rest. Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=""

# SEC EDGAR (annual reports + XBRL financials). SEC requires a name and contact email.
SEC_USER_AGENT="WealthOS you@example.com"

# Finviz Elite: each user connects their own token in the app (Settings or Research → Screener).
